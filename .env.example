# Copy to .env (optional). The app starts without this file; a missing key shows "key not set" on the Call tab.
GEMINI_API_KEY=your_gemini_api_key_here
# Verified with a real Google AI Studio key on Nov 27. Run `node app/scripts/spike.js` to list what your key can call.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
